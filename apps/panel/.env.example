# Copie para `.env` (dev) ou defina no build. Todas são opcionais.

# Origem do processo do bot para o proxy de `/admin/api` no dev server / preview.
# Default: http://localhost:${PORT:-3000}
# BOT_ORIGIN=http://localhost:3000

# Afordâncias de ação / prospecção quando o deploy AINDA NÃO expõe
# `GET /admin/api/capabilities`. Com o endpoint presente, ele tem prioridade.
# "true" liga; ausente/qualquer-outro = desligado (default).
# VITE_MANAGEMENT_ACTIONS=false
# VITE_MANAGEMENT_PROSPECTING=false

# Preview visual do CRM futuro (Pipeline, Oportunidades, Empresas, Campanhas e Analytics).
# Em `vite dev` o preview é ligado automaticamente. Em builds de produção ele fica
# desligado por padrão para impedir que fixtures pareçam dados reais.
# Defina explicitamente como "true" apenas em um deploy de demonstração.
# VITE_CRM_PREVIEW_MODE=false
